# Copy this file to `.env` and fill in your values — the generation script loads
# it at startup (python-dotenv) and mirrors it to the cluster with the repo.

# =============================== REQUIRED ====================================
# Nothing will be spun up without BOTH of these — the launchers exit upfront.

# CoreWeave sandboxes (scripts/sandbox.py, sandbox_generate.py): console token
# with the "Sandbox User" IAM role — https://console.coreweave.com/tokens
CWSANDBOX_API_KEY=
# W&B Inference key — authenticates the Kimi K2.6 lyric/caption composer
# (and W&B run logging, if enabled below): https://wandb.ai/authorize
WANDB_API_KEY=

# ============================== RECOMMENDED ==================================
# Logging runs to W&B is recommended: every song, its full caption/lyrics
# config, and the playable WAV land on a run page you can share. If EITHER
# value below is unset, runs are not logged at all (generation still works).

# Your W&B username or team name, e.g. my-team
WANDB_ENTITY=
# Project to log into — created automatically on the first run, e.g. music_gen
WANDB_PROJECT=

# --- Hugging Face ---
# Token: https://huggingface.co/settings/tokens
# MiniMax-Music3 is CC-BY-4.0 (not gated), but the token authenticates the
# ~57 GB first-time model download (avoids rate limits).
HF_TOKEN=

# Optional: adopt an existing org snapshot (app venv + model weights) instead
# of running the one-time `scripts/sandbox.py seed` yourself.
#SNAPSHOT_ID=

# Optional: custom container image override (pin by digest — the serverless
# GPU pool is heterogeneous: H100 80GB and RTX PRO 6000 96GB).
# Default: pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime
#SANDBOX_IMAGE=

# Optional: seconds scripts/sandbox_generate.py waits for a sandbox to be
# RUNNING before falling back to the Slurm training cluster (default 600).
#MUSICGEN_SANDBOX_BUDGET=600
